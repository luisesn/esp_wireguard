# Host-side crypto test harness (Task #6 in CHANGES-fork.md).
#
# Builds and runs src/crypto/refc's primitives against vectors.h (checked
# in, generated by gen_vectors.py) on the host -- no ESP-IDF, no hardware.
#
#   make           # build ./test_crypto
#   make check     # build and run it
#   make asan      # build and run with ASan+UBSan for extra confidence
#   make vectors   # regenerate vectors.h (needs: pip install cryptography)
#   make clean

CC      ?= gcc
CFLAGS  ?= -std=c11 -Wall -Wextra -O2 -Wno-sign-compare
SRCS    := test_crypto.c \
           ../src/crypto.c \
           ../src/crypto/refc/blake2s.c \
           ../src/crypto/refc/chacha20.c \
           ../src/crypto/refc/chacha20poly1305.c \
           ../src/crypto/refc/poly1305-donna.c \
           ../src/crypto/refc/x25519.c

.PHONY: all check asan vectors clean

all: test_crypto

test_crypto: $(SRCS) vectors.h
	$(CC) $(CFLAGS) -o $@ $(SRCS)

check: test_crypto
	./test_crypto

asan: $(SRCS) vectors.h
	$(CC) $(CFLAGS) -g -O1 -fsanitize=address,undefined -o test_crypto_asan $(SRCS)
	./test_crypto_asan

vectors:
	python3 gen_vectors.py

clean:
	rm -f test_crypto test_crypto_asan
